<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Detect call state (OFFHOOK/IDLE) to auto-suggest the call outcome + duration. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <!-- One-tap direct dialing (no confirmation tap in the dialer). -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <!-- Read the exact duration of the just-finished outgoing call: duration > 0
         means the consumer actually answered (accurate Connected/No Answer). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <!-- Auto-return to the app when the call ends + the in-call info bubble. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Call-monitor foreground service (keeps tracking alive during the call). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- "Call ended — log it", new-complaint and SLA alerts (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Voice notes: Hindi speech-to-text into the notes field. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- In-app self-update: open the system installer for the downloaded APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Cleartext HTTP is only allowed in debug/profile builds (local dev
         against http://10.0.2.2:3000 etc.) — see those manifests. Release
         talks HTTPS to the deployed backend only. -->
    <application
        android:label="FRT Calling"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Lives only while a tracked outgoing call is in progress; brings the
             app back to the foreground when the call ends. -->
        <service
            android:name=".CallMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Tracks an operator-initiated outgoing call to log its outcome" />
        </service>
        
        <!-- Listens for incoming calls to display Caller ID popup when closed -->
        <receiver android:name=".IncomingCallReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Service to draw the Caller ID overlay bubble during an incoming call -->
        <service
            android:name=".IncomingCallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays caller ID info for incoming calls from consumers" />
        </service>

        <!-- Exposes the downloaded update APK (app cache dir) to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Allow tap-to-call to open the phone dialer (Android 11+ package visibility). -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- Voice notes: discover the on-device speech recognition service. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
